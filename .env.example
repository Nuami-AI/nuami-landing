# 문의 메일 발송 (Google Workspace SMTP)
# 서버 전용 값입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 로컬은 .env.local, 배포는 Vercel > Settings > Environment Variables에 설정합니다.

SMTP_HOST=smtp.gmail.com
# 465는 SSL 연결(secure: true), 587은 STARTTLS(secure: false)
SMTP_PORT=465

# SMTP 인증 계정 (로그인 가능한 Google Workspace 계정)
SMTP_USER=jay@nuami.kr
# SMTP_USER 계정 > Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 (16자리, 공백 없이)
SMTP_PASS=

# 메일 발신 주소. SMTP_USER 계정의 Gmail 설정 > 계정 > '다른 주소에서 메일 보내기'에
# 등록되어 있어야 합니다. 등록되지 않은 주소면 Gmail이 SMTP_USER로 바꿔 보냅니다.
SMTP_FROM=hello@nuami.kr

# 문의를 받을 주소 (공용 수신 주소)
INQUIRY_TO=hello@nuami.kr
